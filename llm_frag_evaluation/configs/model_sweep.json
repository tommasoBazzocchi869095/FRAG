{
  "model_root": "/leonardo_work/IscrC_SpecDLM/models",
  "hardware_assumption": {
    "cluster": "CINECA",
    "available_gpus": 16,
    "gpu_type": "A100 64GB",
    "notes": "Initial profiles are for smoke tests and first full runs. Confirm with vLLM memory telemetry before filling all 16 GPUs."
  },
  "collections": [
    {
      "name": "source_collection_pubmed",
      "config": "llm_frag_evaluation/configs/pubmed_config.json",
      "initial_max_model_len": 22528
    },
    {
      "name": "source_collection_wiki",
      "config": "llm_frag_evaluation/configs/wiki_config.json",
      "initial_max_model_len": 12288
    }
  ],
  "datasets": ["mmlu", "medqa", "pubmedqa", "bioasq"],
  "retrievers": ["bm25", "contriever"],
  "experiments": ["zero_shot", "standard_rag", "frag"],
  "zero_shot_retriever": "bm25",
  "profiles": {
    "small_1gpu": {
      "gpus": 1,
      "tensor_parallel_size": 1,
      "time_limit": "08:00:00",
      "cpus_per_task": 4,
      "mem": "80G",
      "dtype": "auto",
      "gpu_memory_utilization": 0.86,
      "max_num_seqs": 8,
      "max_tokens": 1024,
      "initial_batch_size": 4,
      "concurrency_with_16_gpus": 16,
      "notes": "Suitable starting point for 1B-4B models. Run smoke jobs before launching all datasets."
    },
    "medium_1gpu": {
      "gpus": 1,
      "tensor_parallel_size": 1,
      "time_limit": "10:00:00",
      "cpus_per_task": 4,
      "mem": "120G",
      "dtype": "auto",
      "gpu_memory_utilization": 0.88,
      "max_num_seqs": 4,
      "max_tokens": 1024,
      "initial_batch_size": 2,
      "concurrency_with_16_gpus": 16,
      "notes": "Suitable starting point for 7B-14B models on A100 64GB if the 22528-token PubMed profile fits."
    },
    "large_2gpu": {
      "gpus": 2,
      "tensor_parallel_size": 2,
      "time_limit": "12:00:00",
      "cpus_per_task": 4,
      "mem": "180G",
      "dtype": "auto",
      "gpu_memory_utilization": 0.90,
      "max_num_seqs": 2,
      "max_tokens": 1024,
      "initial_batch_size": 1,
      "concurrency_with_16_gpus": 8,
      "notes": "Conservative starting point for 27B-32B models with long PubMed prompts."
    }
  },
