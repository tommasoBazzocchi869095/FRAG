# Copy this file to llm_frag_evaluation/slurm/hpc.private.env on CINECA.
# The private file is ignored by Git.

export ENV_INIT_COMMAND="module purge; module load python/3.11.7"
export VLLM_VENV_ACTIVATE="/path/to/hpc/work/FRAG/.venv_vllm/bin/activate"

export HPC_ACCOUNT="your_account"
export HPC_QOS="normal"
export HPC_PARTITION="boost_usr_prod"
export HPC_MODEL_PATH="/path/to/hpc/work/models/Meta-Llama-3-70B-Instruct"

export GENERATE_TIME_LIMIT="10:00:00"
export GENERATE_CPUS_PER_TASK="4"
export GENERATE_MEM="100G"
export GENERATE_GPUS="4"
export GENERATE_TENSOR_PARALLEL_SIZE="4"
export GENERATE_MAX_MODEL_LEN="4096"
export GENERATE_GPU_MEMORY_UTILIZATION="0.85"
export GENERATE_MAX_TOKENS="512"
export GENERATE_BATCH_SIZE="5"
export SMOKE_PROMPT_LIMIT="5"
